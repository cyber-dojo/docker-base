# This file specifies snyk vulnerabilities to be ignored.
# If this file contains only comments, then no vulnerabilities are ignored
# but do not delete this file - it is needed for the live-snyk-scans repo workflows.
#
# Every entry below is a Go CVE in the docker/dind toolchain (containerd, ctr)
# inherited from the base image. Each is assessed as not-exploitable in
# cyber-dojo; see docs/vulns/ for the per-CVE analysis. Entries expire after 30 days so
# the assessment is forced to be re-reviewed rather than ignored forever.

version: v1.25.0

patch: {}

ignore:
  # CVE-2026-41178 | OTel propagation | Score 6.9 | Not exploitable: only containerd and ctr still vendor otel v1.43.0; containerd serves its API on a local Unix socket and ctr is a CLI, so no attacker-supplied header reaches the baggage parser
  SNYK-GOLANG-GOOPENTELEMETRYIOOTELPROPAGATION-17054905:
    - '*':
        reason: Not exploitable in docker-base context; see docs/vulns/readme.txt
        expires: 2026-09-21T00:00:00.000Z
        created: 2026-06-15T00:00:00.000Z

  # CVE-2026-41178 | OTel baggage | Score 6.9 | Not exploitable: only containerd and ctr still vendor otel v1.43.0; containerd serves its API on a local Unix socket and ctr is a CLI, so no attacker-supplied header reaches the baggage parser
  SNYK-GOLANG-GOOPENTELEMETRYIOOTELBAGGAGE-17054906:
    - '*':
        reason: Not exploitable in docker-base context; see docs/vulns/readme.txt
        expires: 2026-09-21T00:00:00.000Z
        created: 2026-06-15T00:00:00.000Z
